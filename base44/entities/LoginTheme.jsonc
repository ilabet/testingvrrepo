{
  "name": "LoginTheme",
  "type": "object",
  "properties": {
    "background_type": {
      "type": "string",
      "enum": [
        "gradient",
        "image",
        "video"
      ],
      "default": "gradient",
      "enumColors": [
        "gray",
        "blue",
        "purple"
      ]
    },
    "background_url": {
      "type": "string"
    },
    "accent_color": {
      "type": "string",
      "default": "#f4c7d0"
    },
    "dim": {
      "type": "number",
      "default": 55
    },
    "blur": {
      "type": "number",
      "default": 0
    },
    "headline": {
      "type": "string"
    },
    "subheadline": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "frame_style": {
      "type": "string",
      "enum": [
        "none",
        "bronze",
        "gothic",
        "lily",
        "kawaii"
      ],
      "default": "none",
      "enumColors": [
        "gray",
        "yellow",
        "purple",
        "pink",
        "blue"
      ]
    },
    "music_url": {
      "type": "string"
    },
    "music_title": {
      "type": "string"
    }
  },
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}